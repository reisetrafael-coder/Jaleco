{
  "functions": {
    "api/ai.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/lembrete-diario",
      "schedule": "0 21 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}